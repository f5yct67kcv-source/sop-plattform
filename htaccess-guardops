# .htaccess fuer die oeffentliche Homepage auf ihrer eigenen Domain
# (guardops.ch). Der Deploy legt sie als dist-guardops/.htaccess ab.
#
# EIGENE DATEI, NICHT htaccess-hostpoint: Dort steht die Konfiguration des
# Rapport-Tools -- eine Anwendung mit Anmeldung, Standortzugriff, Kamera und
# Mikrofon. Diese Seite hier ist eine Verkaufsseite. Was sie nicht braucht,
# soll sie auch nicht erlauben.

# ── 1. Startseite ────────────────────────────────────────────────────────
# Auf der eigenen Domain gehoert die Homepage auf "/", nicht auf
# "/homepage.html" -- der Deploy legt sie deshalb als index.html ab.
DirectoryIndex index.html

# ── 1b. Eine Adresse, nicht zwei (OP-566) ────────────────────────────────
# www.guardops.ch und guardops.ch zeigen auf dasselbe Verzeichnis. Ohne
# diese Weiterleitung gibt es die Seite damit ZWEIMAL: fuer Suchmaschinen
# zwei getrennte Auftritte, und die Verweise verteilen sich auf beide.
#
# Die kurze Adresse fuehrt -- die Marke ist kurz genug, dass "www" nichts
# hinzufuegt. 301 heisst DAUERHAFT: Browser und Suchmaschinen merken sich
# das lange. Eine spaetere Umkehr waere entsprechend traege.
#
# Greift nur, wenn Hostpoint www.guardops.ch tatsaechlich hierher zeigen
# laesst. Tut es das nicht, laeuft die Regel schlicht nie -- sie richtet
# keinen Schaden an.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.guardops\.ch$ [NC]
  RewriteRule ^(.*)$ https://guardops.ch/$1 [R=301,L]
</IfModule>

# ── 2. Hilfsdateien gegen direkten Abruf sperren ─────────────────────────
# Dieselbe Begruendung wie in htaccess-hostpoint: Faellt die PHP-Verarbeitung
# aus oder ist sie falsch eingestellt, liefert der Server den Quelltext im
# Klartext aus. Diese vier Dateien werden nur von api/demo_senden.php
# eingebunden und nie direkt aufgerufen.
#
# db.php steht hier mit, obwohl es auf dieser Domain ABSICHTLICH KEINE
# Datenbank-Zugangsdaten traegt (der Deploy laesst die __DB_*__-Platzhalter
# stehen). Die Sperre ist trotzdem richtig: Sie darf nicht davon abhaengen,
# dass jemand sich an diese Besonderheit erinnert.
<FilesMatch "^(db|mailer|demo_anfrage|demo_bremse)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Sicherungskopien und Reste, die beim Hochladen entstehen koennen.
<FilesMatch "\.(sql|bak|old|orig|log|md|yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── 3. Schutzkopfzeilen ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Die Seite darf nur in EINEN fremden Rahmen: formateins.ch zeigt sie im
  # Pruefstand seiner Startseite live, als Referenz (24.10.2026). Jeder
  # andere Rahmen bleibt gesperrt, der Schutz gegen Clickjacking damit
  # erhalten. github.io ist die Vorschau von formateins vor dem Livegang.
  #
  # X-Frame-Options kennt nur DENY, SAMEORIGIN und (nicht mehr unterstuetzt)
  # ALLOW-FROM mit genau einer Adresse. frame-ancestors regelt dasselbe
  # genauer, und steht beides, gewinnt in heutigen Browsern frame-ancestors.
  # "unset" statt weglassen: Hostpoint koennte den Header ausserhalb
  # dieser Datei setzen, und ein DENY dort wuerde alte Browser doch sperren.
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://www.formateins.ch https://formateins.ch https://f5yct67kcv-source.github.io"

  # Der Browser soll den Inhaltstyp nicht raten.
  Header always set X-Content-Type-Options "nosniff"

  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HIER BEWUSST ANDERS ALS BEIM RAPPORT-TOOL: Dort stehen Kamera, Mikrofon
  # und Standort auf "(self)", weil der Revierdienst sie braucht. Eine
  # Verkaufsseite braucht nichts davon -- eine leere Liste heisst "niemand,
  # auch diese Seite nicht".
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS: Der Browser merkt sich, dass diese Seite nur verschluesselt zu
  # erreichen ist. Wirkt ERST, wenn die Seite ueber HTTPS ausgeliefert wird.
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# ── 4. Kein Verzeichnisinhalt ────────────────────────────────────────────
Options -Indexes
