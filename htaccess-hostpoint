# Schutzeinstellungen fuer das Web-Verzeichnis (ENT-075).
#
# Diese Datei wird beim Deploy als ".htaccess" ausgeliefert. Sie heisst im
# Repository absichtlich anders: Eine Datei mit fuehrendem Punkt uebersieht
# man beim Durchsehen, und genau diese hier sollte niemand uebersehen.
#
# ═══ WENN DIE SEITE NACH DEM DEPLOY EINEN SERVERFEHLER ZEIGT ═══
# Dann liegt es an dieser Datei. Loeschen: Hostpoint-Verwaltung →
# Dateimanager → im Ordner rapport die Datei .htaccess loeschen. Die Seite
# laeuft danach sofort wieder, nur ohne diese Schutzeinstellungen.
# Alle Anweisungen unten sind gegen alte Apache-Fassungen abgesichert --
# ein Fehler ist unwahrscheinlich, aber der Weg zurueck muss trotzdem
# dastehen.

# ── 1. Hilfsdateien nicht direkt abrufbar ────────────────────────────────
# db.php traegt das Datenbankpasswort, ai.php den Schluessel zur KI, mailer.php
# das SMTP-Passwort fuer den Offert-Versand (ENT-192). Alle liegen im
# Web-Verzeichnis, weil der Deploy per FTP nicht darueber hinaus schreiben
# kann. PHP wird zwar ausgefuehrt statt angezeigt -- aber wenn PHP einmal
# ausfaellt oder falsch eingestellt ist, liefert der Server den Quelltext im
# Klartext aus. Dann waeren die Zugangsdaten oeffentlich.
# Diese Dateien werden nur von den Endpunkten unter /api eingebunden und nie
# direkt aufgerufen; ein direkter Abruf ist also immer verkehrt.
<FilesMatch "^(db|ai|planung|kunden|mitarbeiter|layout|anmeldung|zweifaktor|rechte|logbuch|ereignisse|auslagen|rundgang|fahrzeug|geofence_bereich|belege|qrrechnung|produkte|mailer|ferien|setup)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Sicherungskopien und Reste, die beim Hochladen entstehen koennen.
<FilesMatch "\.(sql|bak|old|orig|log|md|yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── 2. Schutzkopfzeilen ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Die Seite darf nicht in einen fremden Rahmen gesetzt werden. Sonst legt
  # jemand eine unsichtbare Kopie ueber seine eigene Seite und faengt Klicks
  # ab -- der Benutzer glaubt, er klickt dort, und loest hier etwas aus.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"

  # Der Browser soll den Inhaltstyp nicht raten. Sonst kann eine hochgeladene
  # Datei als Skript ausgefuehrt werden, obwohl sie als Bild deklariert war.
  Header always set X-Content-Type-Options "nosniff"

  # Beim Weggehen auf eine fremde Seite nicht verraten, von welcher Adresse
  # aus -- die Adresse kann Hinweise auf den Betrieb enthalten.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Kamera und Standort aus, Mikrofon bleibt: Das Diktat braucht es.
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"

  # HSTS: Der Browser merkt sich, dass diese Seite nur verschluesselt zu
  # erreichen ist. Wirkt ERST, wenn die Seite ueber HTTPS ausgeliefert wird.
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# ── 3. Kein Verzeichnisinhalt ────────────────────────────────────────────
# Ohne das listet Apache in einem Ordner ohne index-Datei alle Dateien auf.
Options -Indexes

# ── 4. HTTPS erzwingen -- BEWUSST AUSGESCHALTET (OP-67) ──────────────────
# Der richtige Weg ist die Hostpoint-Verwaltung: Domain → automatische
# Weiterleitung auf HTTPS einschalten. Nur falls das dort nicht geht, die
# folgenden vier Zeilen entkommentieren. VORHER pruefen, dass
# https://<deine-adresse> im Browser ohne Zertifikatswarnung laedt -- sonst
# ist die Seite danach nicht mehr erreichbar.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
