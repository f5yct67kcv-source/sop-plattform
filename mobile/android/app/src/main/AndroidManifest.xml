<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Schluessel der nativen Karte (ENT-717), von Gradle eingesetzt aus
             mobile/.maps-android-key (app/build.gradle). Nie hier eintragen:
             Diese Datei ist versioniert. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_ANDROID_KEY}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Berechtigungen. Jede hier fehlende laesst die zugehoerige Funktion
         STILL ausfallen: Der WebView fragt nur nach, was hier steht
         (BridgeWebChromeClient in @capacitor/android), und meldet sonst
         einfach "abgelehnt" - ohne Dialog und ohne Fehlermeldung. Das
         Gegenstueck auf iOS sind die *UsageDescription-Texte in Info.plist. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Kontrollpunkt bestaetigen, Weg der Runde, Ereignis verorten.
         FINE ist die GPS-Genauigkeit; ohne sie liefert Android nur eine
         Position auf einige hundert Meter, und kein Kontrollpunkt liesse
         sich bestaetigen. COARSE muss daneben stehen: Seit Android 12 darf
         die Person "ungefaehr" waehlen, und ohne COARSE im Manifest
         bekaeme sie dann gar nichts. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- GPS nicht als Pflicht erklaeren: Sonst blendet Google Play die App
         auf Geraeten ohne GPS-Empfaenger (manche Tablets) ganz aus. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- KEINE Kamera-Berechtigung, und das ist Absicht. Der Fotobeleg
         (Ereignis, Fahrzeuguebernahme, Ersatzscan: input type=file capture)
         oeffnet die Kamera-App des Systems. Die braucht keine Erlaubnis -
         AUSSER die App fuehrt CAMERA im Manifest. Dann fragt Capacitor
         nach, und lehnt die Person ab, gibt es gar kein Foto, auch keine
         Auswahl aus den Bildern (BridgeWebChromeClient.onShowFileChooser).
         Eine Zeile mehr haette hier also nur einen Weg zum Scheitern
         hinzugefuegt. -->

    <!-- Benachrichtigungen (ENT-604). Seit Android 13 eine eigene
         Laufzeit-Erlaubnis; das Push-Plugin bringt sie NICHT selbst mit.
         Fehlt sie, bekommt das Geraet zwar ein Token und meldet sich beim
         Server an - angezeigt wird aber nie etwas. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration beim Erfassen eines Kontrollpunkts (navigator.vibrate).
         Keine Laufzeit-Erlaubnis, aber ohne diese Zeile vibriert nichts. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
