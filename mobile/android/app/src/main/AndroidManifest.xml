<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Schluessel fuer die native Karte (ENT-609). Steht nie hier im
             Klartext: app/build.gradle liest ihn beim Bauen aus
             mobile/.maps-android-key (in .gitignore). Fehlt die Datei,
             bleibt der Wert leer und die Karte in der Runde grau, alles
             andere laeuft. aufs-android.sh warnt dann am Schluss. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Standort fuer die Runde: Ohne ihn laesst sich kein Kontrollpunkt
         bestaetigen. Nur im Vordergrund (ENT-588), darum bewusst KEIN
         ACCESS_BACKGROUND_LOCATION. Gegenstueck zu
         NSLocationWhenInUseUsageDescription in der iOS-Info.plist. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Fotobeleg und Ersatzscan (<input capture>). Ohne diese Zeile
         oeffnet Android statt der Kamera nur die Dateiauswahl. -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
