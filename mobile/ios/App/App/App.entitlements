<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Push-Berechtigung (ENT-604). "development" hier ist RICHTIG, auch fuer
     den Store: Bei automatisch verwalteter Signierung (CODE_SIGN_STYLE =
     Automatic, siehe project.pbxproj) schreibt Xcode diesen Wert beim
     Archivieren fuer TestFlight/App Store selbst auf "production" um --
     das gehoert zum Vorgang, nicht von Hand geaendert werden. Der
     Server (backend/push.php) spricht ohnehin immer nur
     api.push.apple.com an, nie den Sandkasten (siehe push_apns_senden). -->
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
