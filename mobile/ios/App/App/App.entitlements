<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Push-Berechtigung (ENT-604). "development" hier ist RICHTIG, auch fuer
     den Store: Bei automatisch verwalteter Signierung (CODE_SIGN_STYLE =
     Automatic, siehe project.pbxproj) schreibt Xcode diesen Wert beim
     Archivieren fuer TestFlight/App Store selbst auf "production" um --
     das gehoert zum Vorgang, nicht von Hand geaendert werden.

     Was hier "development" steht, heisst aber: Eine ueber Xcode
     installierte App meldet sich bei Apple im SANDKASTEN an und bekommt
     ein Token, das nur dort gilt. Der Server probiert darum beide
     Umgebungen (push_apns_senden in backend/push.php). Ein frueherer
     Vermerk an dieser Stelle behauptete, es genuege die Produktivadresse
     -- das stimmte fuer die Store-Fassung, nicht fuer den Test am eigenen
     Geraet, und dort kam darum nie eine Mitteilung an. -->
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
